FROM dunglas/frankenphp:1.13.4-php8.5-bookworm

RUN php -r 'if (version_compare(PHP_VERSION, "8.5.12", "<")) { fwrite(STDERR, "PHP 8.5.12 or newer is required.\n"); exit(1); }'

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        openssh-client \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
        -exec sed -i \
            -e 's|http://deb.debian.org|https://deb.debian.org|g' \
            -e 's|http://security.debian.org|https://security.debian.org|g' \
            {} + \
    && printf 'Acquire::Retries "3";\n' > /etc/apt/apt.conf.d/80-retries

RUN install-php-extensions bcmath
RUN install-php-extensions exif
RUN install-php-extensions gd
RUN install-php-extensions Imagick/imagick@3.8.1
RUN install-php-extensions intl
RUN install-php-extensions pcntl
RUN install-php-extensions pdo_mysql
RUN install-php-extensions redis
RUN install-php-extensions zip

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY docker/app/Caddyfile /etc/caddy/Caddyfile
COPY docker/app/support-uploads.ini /usr/local/etc/php/conf.d/99-support-uploads.ini

EXPOSE 8000

ENTRYPOINT []

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
